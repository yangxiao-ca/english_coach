# Choose one: deepseek, glm, openai
AI_PROVIDER=deepseek

# Generic variables. These override provider-specific keys below.
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# DeepSeek defaults:
# AI_MODEL=deepseek-v4-flash
# AI_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=

# GLM / 智谱 defaults:
# AI_MODEL=glm-5.2
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_API_KEY=

# OpenAI fallback:
# AI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
